{
  "manifest_version": 3,
  "name": "Floating Clock Test",
  "version": "1.0.0",
  "description": "Test version of floating clock extension",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["debug.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Floating Clock Test"
  }
}
